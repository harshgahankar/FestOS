# Copy to .env and fill in. Never commit the real .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Supabase Dashboard -> Settings -> API -> JWT Secret (fast local token
# verification). When absent, tokens are verified via /auth/v1/user introspection.
SUPABASE_JWT_SECRET=
# Optional: store all fest tables in Supabase Postgres instead of local SQLite
# (Dashboard -> Settings -> Database -> Connection pooling -> session pooler URI).
# URL-encode special chars in the password, e.g. @ -> %40.
SUPABASE_DB_URL=
